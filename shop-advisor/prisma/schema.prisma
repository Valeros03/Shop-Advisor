// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. UTENTE
model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique
  username   String?  // Rimosso firstName come richiesto
  createdAt  DateTime @default(now())
  
  alerts     Alert[]
}

// 2. PRODOTTO (Hub Italia)
model Product {
  id             String   @id @default(uuid())
  asin           String   @unique
  name           String
  image          String

  currentPriceIT Float?
  currentPriceFR Float?
  currentPriceDE Float?

  shippingIT     Float?   @default(0.0)
  shippingFR     Float?   @default(0.0)
  shippingDE     Float?   @default(0.0)

  historyIT      Json?    @default("[]")
  historyFR      Json?    @default("[]")
  historyDE      Json?    @default("[]")

  // --- NUOVE COLONNE SCHEDULAZIONE ---
  priorityCode   Int      @default(3)
  mustTomorrow   Boolean  @default(false)

  unchangedCount  Int      @default(0)

  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())

  alerts         Alert[]

  @@index([lastUpdated]) 
  @@index([priorityCode, mustTomorrow]) // Indice per velocizzare il Dispatcher
}

// 3. CARRELLO / ALERT
model Alert {
  id          String   @id @default(uuid())
  
  userId      String
  productId   String
  
  targetPrice Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Evita duplicati: l'utente non può tracciare 2 volte lo stesso prodotto
  @@unique([userId, productId]) 

  // --- INDICI DI PERFORMANCE ---
  // Velocizza le JOIN e le ricerche nel carrello o quando si controllano le soglie
  @@index([userId])
  @@index([productId])
  @@index([isActive]) // Molto utile quando cerchiamo solo "WHERE isActive = true"
}

model WorkerStat {
  id             String   @id @default(uuid())
  name           String   @unique
  dailyUsage     Int      @default(0)
  monthlyUsage   Int      @default(0)
  lifetimeUsage  Int      @default(0)
  lastResetDaily DateTime @default(now())
  updatedAt      DateTime @updatedAt
}