{
  "name": "shop-advisor-worker",
  "private": true,
  "scripts": {
    "refresh": "tsx src/index.ts --once",
    "worker": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "DATABASE_URL=file:./test.db npx prisma@6.19.3 db push",
    "test": "DATABASE_URL=file:./test.db sh -c 'for file in src/test/*.ts; do npx tsx \"$file\"; done'"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "got-scraping": "^4.2.1",
    "nodemailer": "^10.0.11",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
